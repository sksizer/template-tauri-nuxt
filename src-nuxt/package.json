{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -Rf nuxt_modules .node_modules .nuxt dist package-lock.json pnpm-lock.yaml yarn.lock",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "lint": "eslint . && oxlint .",
    "typecheck": "nuxi typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-1421}",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/scripts": "^1.1.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "^4.7.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@unhead/vue": "^2.1.15",
    "better-sqlite3": "^12.10.0",
    "eslint": "^9.39.4",
    "nuxt": "^4.4.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/vue3": "^10.4.0",
    "@storybook/vue3-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "storybook": "^10.4.0",
    "vitest": "^4.1.6"
  }
}
