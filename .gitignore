# Dev Patterns
.worktrees

# MacOS Misc
.DS_Store

# IDE Cruft
.vscode/

# Node Environment
node_modules

# Nuxt Environment
.nuxt

# Rust Cargo Env
target

# Private downstream repo list (merged with scripts/downstream.txt at runtime)
scripts/downstream.local.txt

# --- Claude Code project-local ---
# Default: ignore everything inside .claude/ ...
.claude/*
# ... then explicitly un-ignore the shareable bits.
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/agents/
!.claude/hooks.json
!.claude/hooks/
!.claude/hooks/**

# --- SDLC plugin project-local ---
# `.sdlc/` is the SDLC plugin's own runtime/config directory at the
# project root, conceptually separate from `.claude/` (Claude Code's
# settings/hooks). Default: ignore everything inside `.sdlc/` ...
.sdlc/*
# ... then explicitly un-ignore the shareable bits.
!.sdlc/skill-ext/
!.sdlc/skill-ext/**
